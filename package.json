{
  "name": "gennews-post",
  "version": "1.0.0",
  "description": "AI news blog post generator for GitHub Pages",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "generate": "node scripts/generate-post.mjs",
    "test:fetch": "node scripts/generate-post.mjs --fetch-only",
    "test:dry": "node scripts/generate-post.mjs --dry-run",
    "translate:existing": "node scripts/translate-existing.mjs",
    "translate:single": "node scripts/translate-single.mjs",
    "validate": "node scripts/validate-post.mjs",
    "validate:all": "node scripts/validate-post.mjs --all"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "dotenv": "^17.3.1",
    "marked": "18.0.14",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
